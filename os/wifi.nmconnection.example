# NetworkManager keyfile — example. Copy to os/wifi/<name>.nmconnection, fill in
# the two CHANGE-ME values, and rebuild: build.sh embeds every os/wifi/*.nmconnection
# into the ISO and the install drops them in /etc/NetworkManager/system-connections
# at 0600. os/wifi/ is gitignored; this example is the only version that is committed.
#
# One file per network the robot has to join. NetworkManager picks between them by
# autoconnect-priority (highest wins), so a venue profile can be added without
# disturbing the lab one:
#
#   30  venue / booth network
#   20  lab 5 GHz
#   10  lab 2.4 GHz fallback
#
# The robot-ctf profile is NOT written from this example: it is generated from
# the Ansible vault in admin/ by os/generate-robot-ctf-profile.sh. This file is
# for the other networks -- the lab, an office, a foreign venue.
#
# No interface-name= on purpose: the profile must bind to whichever wireless device
# the node presents (wlP1p1s0 on the Orin, but that is a per-board name).

[connection]
id=CHANGE-ME
type=wifi
autoconnect=true
autoconnect-priority=20

[wifi]
mode=infrastructure
ssid=CHANGE-ME
# Power save OFF, and this is not a preference. Measured on robot B (2026-08-21),
# pinging from the same /24: default power save gave 171 ms average with 122 ms of
# jitter, while the minimum was 1.3 ms -- the link is fast, the station is simply
# asleep between beacons. powersave=2 took the same test to 3.0 ms / 1.7 ms.
# Ringside streams camera frames over this link and the robots negotiate over A2A
# on it; 170 ms of jitter is visible on the 75" screen.
powersave=2

[wifi-security]
key-mgmt=wpa-psk
psk=CHANGE-ME

[ipv4]
method=auto

# The install disables IPv6 on the wired NIC (network --noipv6); keep the radio
# consistent with it rather than half-dual-stack.
[ipv6]
method=disabled
